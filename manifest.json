{
  "manifest_version": 3,

  "name": "Lenex",
  "description": "CRM, Kanban, leads, workflows, agendamentos e WhatsApp em um só lugar.",
  "version": "1.0.0",

  "action": {
    "default_popup": "src/popup/main.tsx"
  },

  "icons": {
    "128": "icons/icon.png"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["src/whatsapp/main.tsx"]
    }
  ]
}